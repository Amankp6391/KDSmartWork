@{
    ViewData["Title"] = "Privacy Policy";
    ViewData["MetaDescription"] = "Privacy policy and client data handling commitments for KDSmartWork .NET development services.";
}

<section class="page-header py-5 text-white bg-dark-navy position-relative">
    <div class="container py-3">
        <span class="badge bg-primary text-white text-uppercase px-3 py-2 fw-semibold mb-2">Legal & Privacy</span>
        <h1 class="display-5 fw-bold mb-2">Privacy Policy & Client Data Protection</h1>
        <p class="lead text-light-opacity mb-0 fs-6">
            Our commitment to confidentiality, intellectual property protection, and secure data handling.
        </p>
    </div>
</section>

<section class="py-5">
    <div class="container">
        <div class="max-w-800 mx-auto bg-white p-4 p-md-5 rounded-4 shadow-sm border">
            <h4 class="fw-bold text-dark mb-3">1. Information We Collect</h4>
            <p class="text-secondary">
                When you submit an enquiry, project request, or contact form on our website, we collect contact information including your name, company name, email address, phone number, and details regarding your technical requirements. This information is used strictly to evaluate your requirement and communicate with you about your project.
            </p>

            <h4 class="fw-bold text-dark mb-3 mt-4">2. Non-Disclosure & Intellectual Property</h4>
            <p class="text-secondary">
                We respect your intellectual property. All proprietary code, database schemas, business logic, and project specifications shared with our development team remain strictly confidential. We are ready and willing to sign formal Non-Disclosure Agreements (NDAs) prior to discussing any sensitive codebase or proprietary workflow.
            </p>

            <h4 class="fw-bold text-dark mb-3 mt-4">3. Data Security & Storage</h4>
            <p class="text-secondary">
                All data submitted through our website is stored in secure, encrypted databases. We do not sell, rent, or distribute your personal or corporate information to third parties.
            </p>

            <h4 class="fw-bold text-dark mb-3 mt-4">4. Contacting Us About Privacy</h4>
            <p class="text-secondary mb-0">
                If you have questions about our privacy practices, data handling, or wish to request removal of your contact information, please email us at <a href="mailto:contact@kdsmartwork.com" class="text-primary fw-semibold">contact@kdsmartwork.com</a>.
            </p>
        </div>
    </div>
</section>
