@model TeamworkManagamentProjects.ViewModels.Admin.AdminLoginViewModel
@{
    ViewData["Title"] = "Admin Login | Management Portal";
    Layout = "_Layout";
}

<section class="py-5 bg-light min-vh-75 d-flex align-items-center">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-6 col-lg-4">
                <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
                    <div class="bg-dark-navy text-white p-4 text-center">
                        <div class="brand-logo-icon mx-auto mb-2 bg-primary text-white">
                            <i class="bi bi-shield-lock-fill"></i>
                        </div>
                        <h4 class="fw-bold mb-1">Admin Portal</h4>
                        <p class="text-light-opacity text-xs mb-0">Authorized Team Access Only</p>
                    </div>

                    <div class="card-body p-4 p-md-4 bg-white">
                        <form asp-controller="Admin" asp-action="Login" method="post" novalidate>
                            @Html.AntiForgeryToken()
                            <input type="hidden" asp-for="ReturnUrl" />

                            <div asp-validation-summary="ModelOnly" class="alert alert-danger text-xs mb-3" role="alert"></div>

                            <div class="mb-3">
                                <label asp-for="Username" class="form-label fw-semibold text-dark text-xs">Username</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light"><i class="bi bi-person"></i></span>
                                    <input asp-for="Username" class="form-control form-control-sm" placeholder="Enter username" autofocus />
                                </div>
                                <span asp-validation-for="Username" class="text-danger small"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="Password" class="form-label fw-semibold text-dark text-xs">Password</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light"><i class="bi bi-key"></i></span>
                                    <input asp-for="Password" class="form-control form-control-sm" placeholder="Enter password" />
                                </div>
                                <span asp-validation-for="Password" class="text-danger small"></span>
                            </div>

                            <div class="form-check mb-3">
                                <input asp-for="RememberMe" class="form-check-input" />
                                <label asp-for="RememberMe" class="form-check-label text-xs text-secondary">Remember this session</label>
                            </div>

                            <button type="submit" class="btn btn-primary w-100 fw-bold py-2">
                                <i class="bi bi-box-arrow-in-right me-1"></i> Sign In to Dashboard
                            </button>

                            <div class="mt-4 p-2 bg-light rounded text-center text-xs text-muted border">
                                <strong>Default Admin Credentials:</strong><br />
                                Username: <code>admin</code> | Password: <code>AdminPassword123!</code>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
