<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] != null ? ViewData["Title"] + " | " : "")KDSmartWork - Remote .NET Developers</title>
    <meta name="description" content="@(ViewData["MetaDescription"] ?? "Experienced ASP.NET Core, MVC, Web Forms and C# developers available for new projects, existing project maintenance, new module development, full-time and part-time remote work.")" />
    <meta name="keywords" content="ASP.NET Core, ASP.NET MVC, ASP.NET Web Forms, C#, SQL Server, Hire .NET Developer, Remote Developers, Software Maintenance, REST API" />
    <meta property="og:title" content="@(ViewData["Title"] ?? "KDSmartWork - Experienced Remote .NET Developers")" />
    <meta property="og:description" content="@(ViewData["MetaDescription"] ?? "Experienced ASP.NET Core, MVC, Web Forms and C# developers available for full-time, part-time and project-based software engineering.")" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="KDSmartWork" />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">

    <!-- Bootstrap 5 & Bootstrap Icons -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <!-- Custom CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="d-flex flex-column min-vh-100">

    <!-- Top Announcement Bar -->
    <div class="top-announcement-bar py-1 text-white">
        <div class="container d-flex flex-wrap justify-content-between align-items-center text-xs">
            <div class="d-flex align-items-center gap-3">
                <span><i class="bi bi-people-fill me-1 text-accent"></i> 5-Member Remote .NET Team</span>
                <span class="d-none d-md-inline text-muted-custom">|</span>
                <span class="d-none d-md-inline"><i class="bi bi-clock-history me-1 text-accent"></i> 4–8 Years Experience</span>
                <span class="d-none d-lg-inline text-muted-custom">|</span>
                <span class="d-none d-lg-inline"><i class="bi bi-check2-circle me-1 text-success"></i> Full-Time & Part-Time Availability</span>
            </div>
            <div class="d-flex align-items-center gap-3">
                <a href="mailto:contact@kdsmartwork.com" class="text-white text-decoration-none">
                    <i class="bi bi-envelope-fill me-1 text-accent"></i> contact@kdsmartwork.com
                </a>
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <span class="badge bg-warning text-dark"><i class="bi bi-shield-lock-fill me-1"></i> Admin Logged In</span>
                }
            </div>
        </div>
    </div>

    <!-- Main Navigation Header -->
    <header class="sticky-top bg-white shadow-sm border-bottom">
        <nav class="navbar navbar-expand-lg navbar-light py-2">
            <div class="container">
                <a class="navbar-brand d-flex align-items-center gap-2" asp-controller="Home" asp-action="Index">
                    <div class="brand-logo-icon">
                        <i class="bi bi-code-square"></i>
                    </div>
                    <div class="d-flex flex-column">
                        <span class="brand-name">KDSmartWork</span>
                        <span class="brand-subtitle">.NET Software Engineering</span>
                    </div>
                </a>

                <button class="navbar-toggler border-0 shadow-none" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMain" aria-controls="navbarMain" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarMain">
                    <ul class="navbar-nav mx-auto mb-2 mb-lg-0 fw-medium">
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" && ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "active" : "")" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "About" ? "active" : "")" asp-controller="Home" asp-action="About">About Us</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Services" ? "active" : "")" asp-controller="Services" asp-action="Index">Services</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Technologies" ? "active" : "")" asp-controller="Technologies" asp-action="Index">Technologies</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Hire" ? "active" : "")" asp-controller="Hire" asp-action="Index">Hire a Developer</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Team" ? "active" : "")" asp-controller="Team" asp-action="Index">Our Team</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Portfolio" ? "active" : "")" asp-controller="Portfolio" asp-action="Index">Portfolio</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Contact" ? "active" : "")" asp-controller="Contact" asp-action="Index">Contact</a>
                        </li>
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item">
                                <a class="nav-link text-primary fw-bold" asp-controller="Admin" asp-action="Index">Admin Area</a>
                            </li>
                        }
                    </ul>

                    <div class="d-flex align-items-center gap-2">
                        <a asp-controller="Hire" asp-action="Index" class="btn btn-primary btn-sm px-3 py-2 fw-semibold shadow-sm d-flex align-items-center gap-1">
                            <i class="bi bi-person-plus-fill"></i> Hire Developer
                        </a>
                        <a asp-controller="Contact" asp-action="Index" class="btn btn-outline-secondary btn-sm px-3 py-2 fw-semibold">
                            Discuss Project
                        </a>
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <!-- Main Content Container -->
    <main role="main" class="flex-grow-1">
        <div class="container mt-3">
            <partial name="_AlertMessages" />
        </div>
        @RenderBody()
    </main>

    <!-- Professional B2B Footer -->
    <footer class="footer-custom bg-dark-navy text-white pt-5 pb-3 mt-auto">
        <div class="container">
            <div class="row g-4 pb-4 border-bottom border-secondary-subtle">
                <!-- Company Info -->
                <div class="col-lg-4 col-md-6">
                    <div class="d-flex align-items-center gap-2 mb-3">
                        <div class="brand-logo-icon-footer">
                            <i class="bi bi-code-square"></i>
                        </div>
                        <span class="fs-4 fw-bold text-white">KDSmartWork</span>
                    </div>
                    <p class="text-muted-custom mb-3">
                        We are a dedicated remote software development team with 5 experienced .NET developers (4–8 years experience). We build, maintain, and scale high-performance ASP.NET Core, MVC, and Web Forms applications for companies and startups worldwide.
                    </p>
                    <div class="d-flex gap-2">
                        <span class="badge bg-primary-subtle text-primary border border-primary">5+ Developers</span>
                        <span class="badge bg-secondary-subtle text-light border border-secondary">4–8 Yrs Exp</span>
                        <span class="badge bg-success-subtle text-success border border-success">Remote / WFH</span>
                    </div>
                </div>

                <!-- Quick Links -->
                <div class="col-lg-2 col-md-6 col-6">
                    <h5 class="fw-semibold text-white mb-3 text-uppercase fs-6 tracking-wide">Quick Links</h5>
                    <ul class="list-unstyled footer-links">
                        <li><a asp-controller="Home" asp-action="Index"><i class="bi bi-chevron-right text-accent me-1"></i> Home</a></li>
                        <li><a asp-controller="Home" asp-action="About"><i class="bi bi-chevron-right text-accent me-1"></i> About Us</a></li>
                        <li><a asp-controller="Team" asp-action="Index"><i class="bi bi-chevron-right text-accent me-1"></i> Our Team</a></li>
                        <li><a asp-controller="Hire" asp-action="Index"><i class="bi bi-chevron-right text-accent me-1"></i> Hire Developer</a></li>
                        <li><a asp-controller="Portfolio" asp-action="Index"><i class="bi bi-chevron-right text-accent me-1"></i> Projects / Portfolio</a></li>
                        <li><a asp-controller="Contact" asp-action="Index"><i class="bi bi-chevron-right text-accent me-1"></i> Contact Us</a></li>
                    </ul>
                </div>

                <!-- Services -->
                <div class="col-lg-3 col-md-6 col-6">
                    <h5 class="fw-semibold text-white mb-3 text-uppercase fs-6 tracking-wide">Development Services</h5>
                    <ul class="list-unstyled footer-links">
                        <li><a asp-controller="Services" asp-action="Index" asp-route-highlight="aspnet-core-development"><i class="bi bi-chevron-right text-accent me-1"></i> ASP.NET Core Dev</a></li>
                        <li><a asp-controller="Services" asp-action="Index" asp-route-highlight="aspnet-mvc-development"><i class="bi bi-chevron-right text-accent me-1"></i> ASP.NET MVC Dev</a></li>
                        <li><a asp-controller="Services" asp-action="Index" asp-route-highlight="aspnet-webforms-maintenance"><i class="bi bi-chevron-right text-accent me-1"></i> ASP.NET Web Forms Support</a></li>
                        <li><a asp-controller="Services" asp-action="Index" asp-route-highlight="existing-project-maintenance"><i class="bi bi-chevron-right text-accent me-1"></i> Project Maintenance</a></li>
                        <li><a asp-controller="Services" asp-action="Index" asp-route-highlight="new-module-development"><i class="bi bi-chevron-right text-accent me-1"></i> New Module Development</a></li>
                        <li><a asp-controller="Services" asp-action="Index" asp-route-highlight="sql-server-development"><i class="bi bi-chevron-right text-accent me-1"></i> SQL Server Optimization</a></li>
                    </ul>
                </div>

                <!-- Contact & Engagement -->
                <div class="col-lg-3 col-md-6">
                    <h5 class="fw-semibold text-white mb-3 text-uppercase fs-6 tracking-wide">Get in Touch</h5>
                    <ul class="list-unstyled text-muted-custom d-flex flex-column gap-2 mb-3">
                        <li class="d-flex align-items-start gap-2">
                            <i class="bi bi-geo-alt-fill text-accent mt-1"></i>
                            <span>Remote Software Development Team (Supporting US, EU & Global Clients)</span>
                        </li>
                        <li class="d-flex align-items-center gap-2">
                            <i class="bi bi-envelope-fill text-accent"></i>
                            <span>contact@kdsmartwork.com</span>
                        </li>
                        <li class="d-flex align-items-center gap-2">
                            <i class="bi bi-telephone-fill text-accent"></i>
                            <span>+1 (800) 555-0199</span>
                        </li>
                        <li class="d-flex align-items-center gap-2">
                            <i class="bi bi-briefcase-fill text-accent"></i>
                            <span>Full-Time | Part-Time | Project-Based</span>
                        </li>
                    </ul>
                    <a asp-controller="Contact" asp-action="Index" class="btn btn-outline-light btn-sm w-100">
                        <i class="bi bi-send-fill me-1"></i> Send Direct Enquiry
                    </a>
                </div>
            </div>

            <!-- Subfooter -->
            <div class="d-flex flex-wrap justify-content-between align-items-center pt-3 text-xs text-muted-custom">
                <div>
                    &copy; 2026 KDSmartWork. All Rights Reserved.
                </div>
                <div class="d-flex gap-3">
                    <a asp-controller="Home" asp-action="Privacy" class="text-muted-custom text-decoration-none hover-white">Privacy Policy</a>
                    <span>•</span>
                    <a asp-controller="Technologies" asp-action="Index" class="text-muted-custom text-decoration-none hover-white">Technology Stack</a>
                    <span>•</span>
                    <a asp-controller="Admin" asp-action="Index" class="text-muted-custom text-decoration-none hover-white"><i class="bi bi-lock-fill"></i> Admin Portal</a>
                </div>
            </div>
        </div>
    </footer>

    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
