@model TeamworkManagamentProjects.Models.DeveloperProfile

@{
    var initials = string.Join("", Model.Name.Split(' ', StringSplitOptions.RemoveEmptyEntries).Select(w => w[0]));
    if (initials.Length > 2) initials = initials.Substring(0, 2);
    if (string.IsNullOrWhiteSpace(initials)) initials = "DEV";

    var isLeadership = Model.Role.Contains("Founder") || Model.Role.Contains("CTO") || Model.Role.Contains("Lead");
}

<div class="card h-100 developer-card border-0 shadow-sm rounded-4 transition-hover @(isLeadership ? "border-primary-subtle" : "")">
    <div class="card-body p-4 d-flex flex-column">
        <div class="d-flex align-items-center gap-3 mb-3">
            @if (!string.IsNullOrEmpty(Model.ImageUrl))
            {
                <img src="@Model.ImageUrl" alt="@Model.Name" class="dev-avatar-img rounded-circle object-fit-cover shadow-xs border border-primary border-2" />
            }
            else
            {
                <div class="dev-avatar-placeholder rounded-circle d-flex align-items-center justify-content-center text-white bg-primary fs-5 fw-bold shadow-xs">
                    @initials
                </div>
            }
            <div>
                <span class="badge @(isLeadership ? "bg-warning text-dark" : "bg-primary text-white") mb-1">
                    <i class="bi bi-shield-check me-1"></i> @Model.Experience Exp
                </span>
                <h5 class="card-title fw-bold text-dark mb-0 fs-5">@Model.Name</h5>
                <div class="text-xs text-primary fw-semibold">@Model.Role</div>
            </div>
        </div>

        <p class="text-secondary small mb-3">
            @Model.Summary
        </p>

        <div class="mb-3">
            <h6 class="text-uppercase text-xs fw-bold text-muted mb-2 tracking-wider">Primary Skills</h6>
            <div class="d-flex flex-wrap gap-1">
                @foreach (var skill in Model.PrimarySkills)
                {
                    <span class="badge bg-light text-dark border">@skill</span>
                }
            </div>
        </div>

        <div class="mb-4">
            <h6 class="text-uppercase text-xs fw-bold text-muted mb-2 tracking-wider">Core Specializations</h6>
            <ul class="list-unstyled mb-0 small text-secondary">
                @foreach (var spec in Model.KeySpecializations)
                {
                    <li class="d-flex align-items-center gap-2 mb-1">
                        <i class="bi bi-check-circle-fill text-success small"></i>
                        <span>@spec</span>
                    </li>
                }
            </ul>
        </div>

        <div class="mt-auto pt-3 border-top d-flex align-items-center justify-content-between">
            <span class="small text-muted"><i class="bi bi-calendar2-check text-success me-1"></i> @Model.Availability</span>
            <a asp-controller="Hire" asp-action="Index" asp-route-technology="@Model.PrimarySkills.FirstOrDefault()" class="btn btn-outline-primary btn-sm fw-medium">
                Hire This Profile
            </a>
        </div>
    </div>
</div>
