@model TeamworkManagamentProjects.ViewModels.Admin.AdminDashboardViewModel
@{
    ViewData["Title"] = "Admin Dashboard | Enquiries Management";
    Layout = "_Layout";
}

<section class="bg-dark-navy text-white py-4">
    <div class="container">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
            <div>
                <span class="badge bg-primary text-white text-uppercase px-2 py-1 text-xs fw-bold">Admin Portal</span>
                <h2 class="fw-bold mb-0">Client Enquiries Dashboard</h2>
            </div>
            <div class="d-flex align-items-center gap-2">
                <form asp-controller="Admin" asp-action="Logout" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-outline-danger btn-sm fw-semibold">
                        <i class="bi bi-box-arrow-right me-1"></i> Sign Out
                    </button>
                </form>
            </div>
        </div>
    </div>
</section>

<!-- Dashboard Stats -->
<section class="py-4 bg-light border-bottom">
    <div class="container">
        <div class="row g-3">
            <div class="col-6 col-md-3">
                <div class="card border-0 p-3 rounded-3 shadow-xs bg-white text-center">
                    <span class="text-xs text-muted text-uppercase fw-bold">Total Enquiries</span>
                    <h3 class="fw-extrabold text-dark mb-0 mt-1">@Model.TotalEnquiries</h3>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="card border-0 p-3 rounded-3 shadow-xs bg-white text-center border-start border-primary border-4">
                    <span class="text-xs text-primary text-uppercase fw-bold">New Submissions</span>
                    <h3 class="fw-extrabold text-primary mb-0 mt-1">@Model.NewEnquiriesCount</h3>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="card border-0 p-3 rounded-3 shadow-xs bg-white text-center border-start border-warning border-4">
                    <span class="text-xs text-warning text-uppercase fw-bold">In Discussion</span>
                    <h3 class="fw-extrabold text-warning mb-0 mt-1">@Model.InDiscussionCount</h3>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="card border-0 p-3 rounded-3 shadow-xs bg-white text-center border-start border-success border-4">
                    <span class="text-xs text-success text-uppercase fw-bold">Converted / Won</span>
                    <h3 class="fw-extrabold text-success mb-0 mt-1">@Model.ConvertedCount</h3>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Filter & Search Toolbar -->
<section class="py-4">
    <div class="container">
        <div class="card border-0 shadow-sm rounded-4 p-4 mb-4 bg-white">
            <form asp-controller="Admin" asp-action="Index" method="get" class="row g-3 align-items-end">
                <div class="col-md-4">
                    <label class="form-label text-xs fw-bold text-muted text-uppercase">Search Keyword</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light"><i class="bi bi-search"></i></span>
                        <input type="text" name="searchTerm" value="@Model.SearchTerm" class="form-control" placeholder="Name, company, email, keywords..." />
                    </div>
                </div>

                <div class="col-md-3">
                    <label class="form-label text-xs fw-bold text-muted text-uppercase">Service Required</label>
                    <select name="service" class="form-select">
                        <option value="">All Services</option>
                        @foreach (var svc in Model.AvailableServices)
                        {
                            <option value="@svc" selected="@(Model.SelectedService == svc)">@svc</option>
                        }
                    </select>
                </div>

                <div class="col-md-2">
                    <label class="form-label text-xs fw-bold text-muted text-uppercase">Engagement</label>
                    <select name="engagement" class="form-select">
                        <option value="">All Engagements</option>
                        @foreach (var eng in Model.AvailableEngagements)
                        {
                            <option value="@eng" selected="@(Model.SelectedEngagement == eng)">@eng</option>
                        }
                    </select>
                </div>

                <div class="col-md-2">
                    <label class="form-label text-xs fw-bold text-muted text-uppercase">Status</label>
                    <select name="status" class="form-select">
                        <option value="">All Statuses</option>
                        <option value="New" selected="@(Model.SelectedStatus == EnquiryStatus.New)">New</option>
                        <option value="Contacted" selected="@(Model.SelectedStatus == EnquiryStatus.Contacted)">Contacted</option>
                        <option value="InDiscussion" selected="@(Model.SelectedStatus == EnquiryStatus.InDiscussion)">In Discussion</option>
                        <option value="Converted" selected="@(Model.SelectedStatus == EnquiryStatus.Converted)">Converted</option>
                        <option value="Closed" selected="@(Model.SelectedStatus == EnquiryStatus.Closed)">Closed</option>
                    </select>
                </div>

                <div class="col-md-1 d-flex gap-2">
                    <button type="submit" class="btn btn-primary w-100 fw-semibold">
                        Filter
                    </button>
                </div>
            </form>
        </div>

        <!-- Enquiries Table -->
        <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white">
            <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                <h5 class="fw-bold mb-0 text-dark">Enquiries List (@Model.Enquiries.Count)</h5>
                @if (!string.IsNullOrEmpty(Model.SearchTerm) || !string.IsNullOrEmpty(Model.SelectedService) || !string.IsNullOrEmpty(Model.SelectedEngagement) || Model.SelectedStatus.HasValue)
                {
                    <a asp-controller="Admin" asp-action="Index" class="btn btn-sm btn-outline-secondary">
                        <i class="bi bi-x-circle me-1"></i> Clear Filters
                    </a>
                }
            </div>

            @if (!Model.Enquiries.Any())
            {
                <div class="p-5 text-center text-muted">
                    <i class="bi bi-inbox fs-1 text-muted-custom d-block mb-3"></i>
                    <h5>No enquiries found</h5>
                    <p class="small text-secondary mb-0">No records match your selected filter criteria.</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light text-xs text-uppercase text-muted">
                            <tr>
                                <th>#</th>
                                <th>Client / Company</th>
                                <th>Service & Engagement</th>
                                <th>Contact Info</th>
                                <th>Received</th>
                                <th>Status</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.Enquiries)
                            {
                                var statusClass = item.Status switch
                                {
                                    EnquiryStatus.New => "bg-primary text-white",
                                    EnquiryStatus.Contacted => "bg-info text-dark",
                                    EnquiryStatus.InDiscussion => "bg-warning text-dark",
                                    EnquiryStatus.Converted => "bg-success text-white",
                                    EnquiryStatus.Closed => "bg-secondary text-white",
                                    _ => "bg-light text-dark"
                                };

                                <tr>
                                    <td class="fw-bold text-muted">#@item.Id</td>
                                    <td>
                                        <div class="fw-bold text-dark">@item.Name</div>
                                        <div class="text-xs text-muted">@(string.IsNullOrEmpty(item.CompanyName) ? "Individual / Startup" : item.CompanyName)</div>
                                    </td>
                                    <td>
                                        <span class="badge bg-light text-dark border">@item.ServiceRequired</span>
                                        <div class="text-xs text-secondary mt-1">@item.EngagementType</div>
                                    </td>
                                    <td>
                                        <div class="text-xs"><i class="bi bi-envelope me-1 text-muted"></i> <a href="mailto:@item.Email" class="text-decoration-none">@item.Email</a></div>
                                        <div class="text-xs"><i class="bi bi-telephone me-1 text-muted"></i> @item.Phone</div>
                                    </td>
                                    <td class="text-xs text-muted">
                                        @item.CreatedDate.ToString("MMM dd, yyyy")<br />
                                        <span class="text-muted-custom">@item.CreatedDate.ToString("hh:mm tt")</span>
                                    </td>
                                    <td>
                                        <span class="badge @statusClass px-2 py-1 text-xs">@item.Status</span>
                                    </td>
                                    <td class="text-end">
                                        <a asp-controller="Admin" asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-primary fw-semibold">
                                            View Details <i class="bi bi-chevron-right ms-1"></i>
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</section>
