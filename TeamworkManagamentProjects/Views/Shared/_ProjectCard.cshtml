@model TeamworkManagamentProjects.Models.PortfolioProject

<div class="card h-100 project-card border-0 shadow-sm rounded-4 transition-hover">
    <div class="card-body p-4 d-flex flex-column">
        <div class="d-flex justify-content-between align-items-start mb-2">
            <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2 py-1 small">
                @Model.ProjectType
            </span>
            <span class="badge bg-secondary-subtle text-secondary small">
                <i class="bi bi-shield-check me-1"></i> Reference Showcase
            </span>
        </div>

        <h5 class="card-title fw-bold text-dark mt-2 mb-2">@Model.ProjectName</h5>
        <p class="card-text text-secondary small mb-3">@Model.ShortDescription</p>

        <div class="mb-3">
            <h6 class="text-uppercase text-xs fw-bold text-muted mb-2 tracking-wider">Key Architectural Features</h6>
            <ul class="list-unstyled mb-0 small text-secondary">
                @foreach (var feature in Model.Features.Take(3))
                {
                    <li class="d-flex align-items-start gap-2 mb-1">
                        <i class="bi bi-check2-circle text-primary mt-1"></i>
                        <span>@feature</span>
                    </li>
                }
            </ul>
        </div>

        <div class="mt-auto pt-3 border-top">
            <div class="d-flex flex-wrap gap-1 mb-3">
                @foreach (var tech in Model.Technologies)
                {
                    <span class="badge bg-light text-dark border">@tech</span>
                }
            </div>
            <a asp-controller="Contact" asp-action="Index" asp-route-service="@Model.ProjectType" class="btn btn-outline-primary btn-sm w-100 fw-semibold">
                Request Similar Architecture
            </a>
        </div>
    </div>
</div>
