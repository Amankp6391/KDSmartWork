@model TeamworkManagamentProjects.Models.ServiceOffering
@{
    ViewData["Title"] = $"{Model.Title} | .NET Development Services";
    ViewData["MetaDescription"] = Model.ShortDescription;
}

<section class="page-header py-5 text-white bg-dark-navy position-relative">
    <div class="container py-3">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb text-xs mb-2">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-white-50 text-decoration-none">Home</a></li>
                <li class="breadcrumb-item"><a asp-controller="Services" asp-action="Index" class="text-white-50 text-decoration-none">Services</a></li>
                <li class="breadcrumb-item active text-white" aria-current="page">@Model.Title</li>
            </ol>
        </nav>
        <h1 class="display-5 fw-bold mb-2">@Model.Title</h1>
        <p class="lead text-light-opacity mb-0 fs-6">@Model.ShortDescription</p>
    </div>
</section>

<section class="py-5">
    <div class="container">
        <div class="row g-5">
            <div class="col-lg-8">
                <div class="bg-white p-4 p-md-5 rounded-4 shadow-sm border mb-4">
                    <h3 class="fw-bold mb-3 text-dark">Overview</h3>
                    <p class="text-secondary lead fs-6 mb-4">
                        @Model.DetailedDescription
                    </p>

                    <h4 class="fw-bold mb-3 text-dark">Key Benefits & Outcomes</h4>
                    <div class="row g-3 mb-4">
                        @foreach (var benefit in Model.Benefits)
                        {
                            <div class="col-sm-6">
                                <div class="p-3 bg-light rounded-3 border d-flex align-items-start gap-2 h-100">
                                    <i class="bi bi-check-circle-fill text-success fs-5 mt-1"></i>
                                    <span class="text-secondary small fw-medium">@benefit</span>
                                </div>
                            </div>
                        }
                    </div>

                    <h4 class="fw-bold mb-3 text-dark">Technologies & Frameworks Utilized</h4>
                    <div class="d-flex flex-wrap gap-2 mb-4">
                        @foreach (var tech in Model.TechnologiesUsed)
                        {
                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-3 py-2 fs-6">
                                @tech
                            </span>
                        }
                    </div>
                </div>
            </div>

            <div class="col-lg-4">
                <div class="card border-0 shadow-sm rounded-4 p-4 bg-light border sticky-top" style="top: 100px;">
                    <h5 class="fw-bold text-dark mb-3">Discuss This Service</h5>
                    <p class="text-secondary small mb-4">
                        Need @Model.Title for your project? Talk with our senior developers directly.
                    </p>
                    <a asp-controller="Contact" asp-action="Index" asp-route-service="@Model.Title" class="btn btn-primary w-100 fw-bold py-2 mb-2">
                        <i class="bi bi-chat-dots-fill me-1"></i> Contact Us
                    </a>
                    <a asp-controller="Hire" asp-action="Index" asp-route-technology="@Model.TechnologiesUsed.FirstOrDefault()" class="btn btn-outline-secondary w-100 fw-bold py-2">
                        <i class="bi bi-person-plus-fill me-1"></i> Hire Dedicated Developer
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>
